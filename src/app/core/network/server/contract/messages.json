{
  "description": "封筒の例。client はサーバーが受け付けるもの、invalid はサーバーが bad-message で断るもの、server はサーバーが送る形（serverTime などの値は例）",
  "client": {
    "hello": {
      "type": "hello",
      "protocolVersion": 1,
      "peerId": "a1B2c3XyZq9W8e7r6-",
      "userId": "8c5b7f0e-2c1d-4e3f-9a8b-7c6d5e4f3a2b"
    },
    "helloWithPassword": {
      "type": "hello",
      "protocolVersion": 1,
      "peerId": "a1B2c3Xy7q9W8e7r6-Pa55w0r",
      "userId": "8c5b7f0e-2c1d-4e3f-9a8b-7c6d5e4f3a2b",
      "password": "secret"
    },
    "broadcast": {
      "type": "send",
      "events": [
        {
          "eventName": "UPDATE_GAME_OBJECT",
          "data": {
            "aliasName": "character",
            "identifier": "3f1c9a52-8d0b-4e7f-a1c3-5b9d2e6f7a80",
            "majorVersion": 4,
            "minorVersion": 0.6180339887,
            "syncData": {
              "location": {
                "name": "table",
                "x": 150,
                "y": 300
              }
            }
          },
          "sendFrom": "a1B2c3XyZq9W8e7r6-"
        },
        {
          "eventName": "CURSOR_MOVE",
          "data": [120, 340],
          "sendFrom": "a1B2c3XyZq9W8e7r6-"
        }
      ]
    },
    "toOnePeer": {
      "type": "send",
      "to": "Zz9Yy8XyZq9W8e7r6-",
      "events": [
        {
          "eventName": "WRITING_A_MESSAGE_DETAIL",
          "data": "...",
          "sendFrom": "a1B2c3XyZq9W8e7r6-"
        }
      ]
    },
    "toAuthority": {
      "type": "send",
      "to": "@authority",
      "events": [
        {
          "eventName": "SYNCHRONIZE_GAME_OBJECT",
          "data": [
            {
              "identifier": "3f1c9a52-8d0b-4e7f-a1c3-5b9d2e6f7a80",
              "version": 4.6180339887
            }
          ],
          "sendFrom": "a1B2c3XyZq9W8e7r6-"
        }
      ]
    },
    "time": {
      "type": "time"
    }
  },
  "invalid": [
    {
      "type": "send"
    },
    {
      "type": "send",
      "events": {}
    },
    {
      "type": "send",
      "events": [
        {
          "data": 1
        }
      ]
    },
    {
      "type": "send",
      "to": 1,
      "events": []
    },
    {
      "type": "bogus"
    },
    "hello",
    null
  ],
  "server": {
    "welcome": {
      "type": "welcome",
      "protocolVersion": 1,
      "peerId": "a1B2c3XyZq9W8e7r6-",
      "authorityPeerId": "@authority",
      "members": [
        {
          "peerId": "Zz9Yy8XyZq9W8e7r6-",
          "userId": "0f9e8d7c-6b5a-4938-2716-0504f3e2d1c0"
        }
      ],
      "serverTime": 1792000000000
    },
    "join": {
      "type": "join",
      "member": {
        "peerId": "Zz9Yy8XyZq9W8e7r6-",
        "userId": "0f9e8d7c-6b5a-4938-2716-0504f3e2d1c0"
      }
    },
    "leave": {
      "type": "leave",
      "peerId": "Zz9Yy8XyZq9W8e7r6-"
    },
    "data": {
      "type": "data",
      "from": "@authority",
      "events": [
        {
          "eventName": "REQUEST_GAME_OBJECT",
          "data": "3f1c9a52-8d0b-4e7f-a1c3-5b9d2e6f7a80",
          "sendFrom": "@authority"
        }
      ]
    },
    "time": {
      "type": "time",
      "serverTime": 1792000000000
    },
    "error": {
      "type": "error",
      "code": "protocol-mismatch",
      "protocolVersion": 1
    }
  }
}
